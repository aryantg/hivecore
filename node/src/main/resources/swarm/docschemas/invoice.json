{
  "class": "invoice",
  "version": "1",
  "description": "a bill from a vendor asking for payment",
  "fields": [
    {"name": "vendor", "type": "string"},
    {"name": "invoice_no", "type": "string"},
    {"name": "date", "type": "date"},
    {"name": "total", "type": "number"},
    {"name": "status", "type": "enum", "values": ["PAID", "UNPAID", "DUE", "OVERDUE", "PENDING"], "normalise": "status"},
    {"name": "gstin", "type": "string", "pattern": "[0-9]{2}[A-Z]{5}[0-9]{4}[A-Z][1-9A-Z]Z[0-9A-Z]", "llm": false}
  ]
}
