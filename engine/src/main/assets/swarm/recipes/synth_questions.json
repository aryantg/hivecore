{
  "id": "synth_questions",
  "version": "1",
  "title": "Synthetic test questions",
  "produces": "New test questions, each validated against the seed data and then evaluated; invalid ones are dropped",
  "axis": "pipeline",
  "merge": "concat",
  "input": "prompt",
  "itemKinds": ["prompt"],
  "sink": "table",
  "table": "t_job_synth",
  "replicate": "sample:0.1",
  "stages": [
    {"id": "gen", "op": "SYNTH_GEN", "params": {"brief": "{item}", "n": 20}},
    {"id": "validate", "op": "SYNTH_VALIDATE", "inputs": ["gen"]},
    {"id": "eval", "op": "EVAL", "inputs": ["validate"]}
  ],
  "outputSchema": [
    {"name": "question", "type": "TEXT"},
    {"name": "valid", "type": "INTEGER"},
    {"name": "reason", "type": "TEXT"},
    {"name": "expected", "type": "TEXT"},
    {"name": "pass", "type": "INTEGER"}
  ]
}
