{
  "id": "image_batch_variants",
  "version": "1",
  "title": "Image variants",
  "produces": "24 image variants of one brief, one seed per chunk across the phones, ranked by score",
  "axis": "fanout",
  "merge": "rank",
  "input": "prompt",
  "itemKinds": ["prompt"],
  "sink": "folder",
  "replicate": "sample:0.1",
  "stages": [
    {"id": "gen", "op": "GEN_VARIANTS", "params": {"prompt": "{item}", "n": 24, "seed": 1, "steps": 20, "guidance": 7.5, "size": 512}},
    {"id": "score", "op": "SCORE_IMAGE", "params": {"prompt": "{item}"}, "inputs": ["gen"]},
    {"id": "rank", "op": "RANK", "params": {"by": ["safe", "clip", "iqa"]}, "inputs": ["score"]}
  ]
}
