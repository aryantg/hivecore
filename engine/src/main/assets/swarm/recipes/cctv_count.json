{
  "id": "cctv_count",
  "version": "1",
  "title": "CCTV people count",
  "produces": "People and vehicles per minute in t_job_counts, counted over frame ranges in parallel",
  "axis": "chunk",
  "merge": "monoid",
  "input": "files",
  "itemKinds": ["video"],
  "sink": "table",
  "table": "t_job_counts",
  "replicate": "sample:0.1",
  "stages": [
    {"id": "frames", "op": "FRAME_SAMPLE", "params": {"item": "{item}", "everySec": 1, "sceneChange": true, "width": 640}},
    {"id": "detect", "op": "DETECT", "params": {"labels": ["person", "car", "bicycle"], "minScore": 0.4}, "inputs": ["frames"]},
    {"id": "track", "op": "TRACK_AGG", "params": {"iou": 0.3, "per": "minute"}, "inputs": ["detect"]}
  ],
  "outputSchema": [
    {"name": "minute", "type": "TEXT", "groupable": true},
    {"name": "label", "type": "TEXT", "groupable": true},
    {"name": "n", "type": "INTEGER"}
  ]
}
