{
  "id": "meeting_minutes",
  "version": "1",
  "title": "Meeting minutes",
  "produces": "A transcript stitched from 30 s chunks, an extractive summary and action items in t_job_actions",
  "axis": "chunk",
  "merge": "stitch",
  "input": "files",
  "itemKinds": ["audio"],
  "sink": "table+folder",
  "table": "t_job_actions",
  "replicate": "sample:0.1",
  "stages": [
    {"id": "vad", "op": "VAD_SPLIT", "params": {"item": "{item}", "maxSec": 30, "overlapSec": 1}},
    {"id": "asr", "op": "ASR", "params": {"modelId": "whisper_tiny"}, "inputs": ["vad"]},
    {"id": "summary", "op": "SUMMARIZE", "params": {"mode": "extractive", "sentences": 8}, "inputs": ["asr"]},
    {"id": "kind", "op": "TEXT_CLASSIFY", "params": {"labels": ["action", "decision", "info"]}, "inputs": ["asr"]},
    {"id": "fields", "op": "METADATA", "params": {"fields": ["owner", "due"]}, "inputs": ["kind"]}
  ],
  "outputSchema": [
    {"name": "sentence", "type": "TEXT"},
    {"name": "kind", "type": "TEXT", "groupable": true},
    {"name": "owner", "type": "TEXT", "groupable": true},
    {"name": "due", "type": "TEXT"},
    {"name": "at_sec", "type": "REAL"}
  ]
}
