{
  "id": "catalog_cleanup",
  "version": "1",
  "title": "Catalogue cleanup",
  "produces": "One row per product photo in t_job_catalog: quality verdict, near-duplicate group and tags",
  "axis": "shard",
  "merge": "concat",
  "input": "images",
  "itemKinds": ["image"],
  "sink": "table",
  "table": "t_job_catalog",
  "replicate": "sample:0.1",
  "stages": [
    {"id": "prep", "op": "IMG_PREPROC", "params": {"item": "{item}", "steps": ["exif_rotate", "resize:512"]}},
    {"id": "iqa", "op": "IQA", "inputs": ["prep"]},
    {"id": "embed", "op": "EMBED", "params": {"modelId": "clip_image"}, "inputs": ["prep"]},
    {"id": "cluster", "op": "CLUSTER", "params": {"kind": "near_duplicate", "minCosine": 0.95}, "inputs": ["embed"]},
    {"id": "tag", "op": "TAG", "params": {"vocabulary": "owner:catalog_tags", "minScore": 0.25}, "inputs": ["prep"]}
  ],
  "outputSchema": [
    {"name": "verdict", "type": "TEXT", "groupable": true},
    {"name": "cluster", "type": "INTEGER", "groupable": true},
    {"name": "duplicate_of", "type": "TEXT"},
    {"name": "tags", "type": "TEXT"}
  ]
}
