{
  "id": "gate2_eval",
  "version": "1",
  "title": "Gate 2 evaluation",
  "produces": "Pass/fail per test question in t_job_eval; ask \"pass rate by category\" afterwards",
  "axis": "shard",
  "merge": "concat",
  "input": "none",
  "itemKinds": ["question"],
  "sink": "table",
  "table": "t_job_eval",
  "replicate": "sample:0.1",
  "stages": [
    {"id": "eval", "op": "EVAL", "params": {"cases": ["questions_50", "questions_composite"], "item": "{item}"}}
  ],
  "outputSchema": [
    {"name": "question", "type": "TEXT"},
    {"name": "category", "type": "TEXT", "groupable": true},
    {"name": "pass", "type": "INTEGER"},
    {"name": "got", "type": "TEXT"},
    {"name": "expected", "type": "TEXT"},
    {"name": "ms", "type": "INTEGER"}
  ]
}
