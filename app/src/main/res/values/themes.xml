<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The window behind Compose (edge to edge) and the platform splash (minSdk 31: no splash library needed). -->
    <style name="Theme.HiveCore" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/hive_window</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowSplashScreenBackground">@color/hive_window</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/hive_amber</item>
    </style>
</resources>
